# LF everywhere so hashes of committed files and docs/usage-cli.md are identical on Windows and Linux.
* text=auto eol=lf
*.ps1 text eol=crlf
*.iss text eol=crlf
*.png binary
*.jpg binary
*.pdf binary
examples/sample/evidence/** binary
tests/golden/*.zip binary
# Certificate fixtures and anchors: byte-exact (hashes, signatures and DER must never be touched by eol rules).
examples/sample/anchors/** binary
tests/fixtures/openssl/** binary
*.crt binary
*.cer binary
*.crl binary
*.der binary
*.p7b binary
*.p12 binary
*.pfx binary
*.tsr binary
*.tst binary
*.ocsp binary
tests/fixtures/inventory/** binary
